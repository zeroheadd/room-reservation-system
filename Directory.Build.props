<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Keep SDK/package caches out of the compile globs when they live inside the repo. -->
  <ItemGroup>
    <Compile Remove=".dotnet\**" />
    <Compile Remove=".npm-cache\**" />
    <Compile Remove=".tmp\**" />
    <None Remove=".dotnet\**" />
    <None Remove=".npm-cache\**" />
    <None Remove=".tmp\**" />
  </ItemGroup>

</Project>
