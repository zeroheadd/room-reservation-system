<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repository-local NuGet configuration.

    "nuget.org" is the normal source. "local-bridge" is only needed on hosts where the .NET CLI
    cannot complete a TLS handshake itself (see tools/nuget-bridge.js): run that helper, then
    restore picks up packages over plain HTTP to localhost.

    Only one source is enabled at a time. Leaving nuget.org enabled next to an unreachable
    bridge makes restore retry the failing source for minutes before giving up.

    To restore against the real feed instead, comment out "local-bridge" and uncomment
    "nuget.org".
  -->
  <packageSources>
    <clear />
    <add key="local-bridge" value="http://127.0.0.1:5099/v3/index.json" protocolVersion="3" allowInsecureConnections="true" />
    <!-- <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" /> -->
  </packageSources>

  <!--
    Packages are still verified by hash; this only skips the extra repository-signature fetch,
    which needs its own endpoint (api.nuget.org/v3-index) that the bridge does not serve.
  -->
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
